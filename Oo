-- ฟังก์ชันหาเป้าหมาย
local function GetClosestTarget()
    local TargetPart = nil
    local MaxDist = Settings.FOVSize

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local Part = player.Character:FindFirstChild(Settings.AimPart) or player.Character:FindFirstChild("Head")
            if Part then
                local TargetPos = Part.Position
                if player.Character:FindFirstChild("HumanoidRootPart") then
                    TargetPos = TargetPos + (player.Character.HumanoidRootPart.AssemblyLinearVelocity * Settings.Prediction)
                end

                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetPos)
                local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local Mag = (Vector2.new(ScreenPos.X, ScreenPos.Y) - CenterScreen).Magnitude

                if OnScreen and Mag < MaxDist then
                    TargetPart = Part
                    MaxDist = Mag
                end
            end
        end
    end
    return TargetPart
end

-- ฟังก์ชันสร้างเส้นวิถีกระสุน Bullet Tracer (รองรับการปรับสีและความหนา)
local function CreateBulletTracer(fromPos, toPos)
    if not Settings.BulletTracer then return end
    pcall(function()
        local distance = (fromPos - toPos).Magnitude
        local tracer = Instance.new("Part")
        tracer.Name = "BulletTracer"
        tracer.Anchored = true
        tracer.CanCollide = false
        tracer.Material = Enum.Material.Neon
        tracer.Color = Settings.TracerColor
        tracer.Size = Vector3.new(Settings.TracerThickness, Settings.TracerThickness, distance)
        tracer.CFrame = CFrame.new(fromPos, toPos) * CFrame.new(0, 0, -distance / 2)
        tracer.Parent = workspace

        local tweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(tracer, tweenInfo, {
            Size = Vector3.new(0, 0, distance),
            Transparency = 1
        })

        tween:Play()
        tween.Completed:Connect(function()
            tracer:Destroy()
        end)
    end)
end

-- ยิงกระสุนเมื่อใช้งาน Tool
local function HookTool(tool)
    if tool:IsA("Tool") then
        tool.Activated:Connect(function()
            if Settings.BulletTracer and LocalPlayer.Character then
                local origin = tool:FindFirstChild("Handle") and tool.Handle.Position or LocalPlayer.Character.Head.Position
                local targetPart = GetClosestTarget()
                local targetPos = (Settings.SilentAim and targetPart) and targetPart.Position or Mouse.Hit.Position

                CreateBulletTracer(origin, targetPos)
            end
        end)
    end
end

if LocalPlayer.Character then
    for _, item in pairs(LocalPlayer.Character:GetChildren()) do
        HookTool(item)
    end
    LocalPlayer.Character.ChildAdded:Connect(HookTool)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char.ChildAdded:Connect(HookTool)
end)

local function GetItemDetails(itemName)
    local lowerName = string.lower(itemName)
    local icon = "🗡️"
    
    if string.find(lowerName, "gun") or string.find(lowerName, "pistol") or string.find(lowerName, "rifle") or string.find(lowerName, "shotgun") or string.find(lowerName, "sniper") or string.find(lowerName, "bazooka") or string.find(lowerName, "blaster") then
        icon = "🔫"
    end

    if string.find(lowerName, "god") or string.find(lowerName, "mythic") or string.find(lowerName, "ultra") or string.find(lowerName, "secret") then
        return icon, Color3.fromRGB(255, 215, 0), "ตำนานสุดๆ"
    elseif string.find(lowerName, "legendary") or string.find(lowerName, "epic") then
        return icon, Color3.fromRGB(170, 0, 255), "ตำนาน"
    elseif string.find(lowerName, "rare") or string.find(lowerName, "uncommon") then
        return icon, Color3.fromRGB(0, 191, 255), "หายาก"
    else
        return icon, Color3.fromRGB(255, 255, 255), "หาง่าย"
    end
end

-- Metatable สำหรับ Silent Aim
if getrawmetatable and setreadonly and newcclosure then
    pcall(function()
        local RawMetatable = getrawmetatable(game)
        local OldIndex = RawMetatable.__index
        local OldNamecall = RawMetatable.__namecall
        setreadonly(RawMetatable, false)

        RawMetatable.__index = newcclosure(function(self, index)
            if Settings.SilentAim and self == Mouse and not checkcaller() then
                local TargetPart = GetClosestTarget()
                if TargetPart then
                    if index == "Hit" then return TargetPart.CFrame
                    elseif index == "Target" then return TargetPart end
                end
            end
            return OldIndex(self, index)
        end)

        RawMetatable.__namecall = newcclosure(function(self, ...)
            local Method = getnamecallmethod()
            local Args = {...}

            if not checkcaller() and (Method == "FireServer" or Method == "InvokeServer") then
                local TargetPart = GetClosestTarget()
                if Settings.SilentAim and TargetPart then
                    local TargetPos = TargetPart.Position
                    if TargetPart.Parent and TargetPart.Parent:FindFirstChild("HumanoidRootPart") then
                        TargetPos = TargetPos + (TargetPart.Parent.HumanoidRootPart.AssemblyLinearVelocity * Settings.Prediction)
                    end

                    for i, arg in pairs(Args) do
                        if typeof(arg) == "CFrame" then Args[i] = CFrame.new(Camera.CFrame.Position, TargetPos)
                        elseif typeof(arg) == "Vector3" then Args[i] = TargetPos
                        elseif typeof(arg) == "Ray" then Args[i] = Ray.new(Camera.CFrame.Position, (TargetPos - Camera.CFrame.Position).Unit * 1000)
                        elseif typeof(arg) == "Instance" and (arg:IsA("BasePart") or arg:IsA("Model")) then Args[i] = TargetPart
                        end
                    end
                    return OldNamecall(self, unpack(Args))
                end
            end
            return OldNamecall(self, ...)
        end)

        setreadonly(RawMetatable, true)
    end)
end

RunService.RenderStepped:Connect(function()
    FOVFrame.Visible = Settings.ShowFOV
    FOVFrame.Size = UDim2.new(0, Settings.FOVSize * 2, 0, Settings.FOVSize * 2)

    if TargetLine then
        if Settings.SilentAim then
            local TargetPart = GetClosestTarget()
            if TargetPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
                local ourHeadScreen, ourHeadOnScreen = Camera:WorldToViewportPoint(LocalPlayer.Character.Head.Position)
                local targetScreen, targetOnScreen = Camera:WorldToViewportPoint(TargetPart.Position)

                if ourHeadOnScreen and targetOnScreen then
                    TargetLine.From = Vector2.new(ourHeadScreen.X, ourHeadScreen.Y)
                    TargetLine.To = Vector2.new(targetScreen.X, targetScreen.Y)
                    TargetLine.Visible = true
                else
                    TargetLine.Visible = false
                end
            else
                TargetLine.Visible = false
            end
        else
            TargetLine.Visible = false
        end
    end

    local Character = LocalPlayer.Character
    if Character and Character:FindFirstChild("Humanoid") and Character:FindFirstChild("HumanoidRootPart") then
        local Humanoid = Character.Humanoid
        local RootPart = Character.HumanoidRootPart

        if Settings.AntiAimEnabled then
            Humanoid.AutoRotate = false
            SpinAngle = (SpinAngle + Settings.AntiAimSpeed) % 360
            RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, math.rad(SpinAngle), 0)
        else
            Humanoid.AutoRotate = true
        end

        if Settings.UndergroundMode then
            RootPart.CFrame = CFrame.new(RootPart.Position.X, Settings.UndergroundDepth, RootPart.Position.Z) * RootPart.CFrame.Rotation
            for _, part in pairs(Character:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        if Settings.CFrameSpeedEnabled and Humanoid.MoveDirection.Magnitude > 0 then
            RootPart.CFrame = RootPart.CFrame + (Humanoid.MoveDirection * Settings.SpeedMultiplier)
        end

        if Settings.JumpPowerEnabled then
            Humanoid.UseJumpPower = true
            Humanoid.JumpPower = Settings.JumpPowerValue
        else
            if Humanoid.JumpPower == Settings.JumpPowerValue then
                Humanoid.JumpPower = 50
            end
        end
    end

    if Settings.ESPName or Settings.ESPItem then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                if not ESPObjects[player] then
                    local Billboard = Instance.new("BillboardGui")
                    Billboard.Size = UDim2.new(0, 200, 0, 60)
                    Billboard.Adornee = player.Character.Head
                    Billboard.AlwaysOnTop = true
                    Billboard.ExtentsOffset = Vector3.new(0, 2.5, 0)
                    
                    local NameLabel = Instance.new("TextLabel", Billboard)
                    NameLabel.Name = "NameLabel"
                    NameLabel.Size = UDim2.new(1, 0, 0.4, 0)
                    NameLabel.BackgroundTransparency = 1
                    NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    NameLabel.TextSize = 9
                    NameLabel.Font = Enum.Font.SourceSansBold
                    NameLabel.TextStrokeTransparency = 0.5

                    local ItemLabel = Instance.new("TextLabel", Billboard)
                    ItemLabel.Name = "ItemLabel"
                    ItemLabel.Position = UDim2.new(0, 0, 0.45, 0)
                    ItemLabel.Size = UDim2.new(1, 0, 0.5, 0)
                    ItemLabel.BackgroundTransparency = 1
                    ItemLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    ItemLabel.TextSize = 8
                    ItemLabel.Font = Enum.Font.SourceSansBold
                    ItemLabel.TextStrokeTransparency = 0.5

                    Billboard.Parent = player.Character.Head
                    ESPObjects[player] = Billboard
                end

                local gui = ESPObjects[player]
                if gui and gui:FindFirstChild("NameLabel") then
                    gui.NameLabel.Visible = Settings.ESPName
                    gui.NameLabel.Text = player.Name

                    local itemGui = gui:FindFirstChild("ItemLabel")
                    if itemGui then
                        itemGui.Visible = Settings.ESPItem
                        if Settings.ESPItem then
                            local displayString = ""
                            local foundValidItem = false
                            
                            local char = player.Character
                            if char then
                                for _, item in pairs(char:GetChildren()) do
                                    if item:IsA("Tool") then
                                        local icon, color = GetItemDetails(item.Name)
                                        itemGui.TextColor3 = color
                                        displayString = icon .. " " .. item.Name
                                        foundValidItem = true
                                        break
                                    end
                                end
                            end

                            if not foundValidItem then
                                local backpack = player:FindFirstChild("Backpack")
                                if backpack then
                                    for _, item in pairs(backpack:GetChildren()) do
                                        if item:IsA("Tool") then
                                            local icon, color = GetItemDetails(item.Name)
                                            itemGui.TextColor3 = color
                                            displayString = icon .. " " .. item.Name
                                            foundValidItem = true
                                            break
                                        end
                                    end
                                end
                            end

                            if foundValidItem then
                                itemGui.Text = displayString
                            else
                                itemGui.TextColor3 = Color3.fromRGB(150, 150, 150)
                                itemGui.Text = "❌ [No Weapon]"
                            end
                        end
                    end
                end
            end
        end
    else
        for player, gui in pairs(ESPObjects) do if gui then gui:Destroy() end end
        ESPObjects = {}
    end

    if Settings.BoxESP then
        for _, obj in pairs(workspace:GetDescendants()) do
            if (obj:IsA("Model") or obj:IsA("BasePart")) and string.find(string.lower(obj.Name), "box") then
                if not BoxESPObjects[obj] then
                    local Highlight = Instance.new("Highlight")
                    Highlight.Adornee = obj
                    Highlight.FillColor = Color3.fromRGB(0, 191, 255)
                    Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    Highlight.FillTransparency = 0.5
                    Highlight.Parent = obj
                    BoxESPObjects[obj] = Highlight
                end
            end
        end
    else
        for obj, highlight in pairs(BoxESPObjects) do if highlight then highlight:Destroy() end end
        BoxESPObjects = {}
    end
end)

